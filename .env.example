# Copy to .env.local and fill in. Never commit .env.local.
# Only the first block is required to boot; every integration below is optional
# and its tab degrades gracefully when the variables are missing.

# --- Required -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # publishable key (client never queries tables: RLS is deny-all)
SUPABASE_SERVICE_ROLE_KEY=           # server-only; bypasses RLS
AUTH_SECRET=                         # long random string; signs the session cookie
DASHBOARD_PASSWORD=                  # the single login password
USER_TIMEZONE=America/Denver         # IANA zone used for "today", reminders and the briefing

# Direct Postgres URL, only for scripts/apply-migration.mjs (DDL can't go through PostgREST)
SUPABASE_DB_URL=

# --- AI -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                     # optional override for the default model
ANTHROPIC_MODEL_HEAVY=               # optional override for long-form drafting
OPENAI_API_KEY=                      # fallback provider
OPENAI_MODEL=
SUPERMEMORY_API_KEY=                 # optional long-term memory backend

# --- Finance (Plaid) ------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
PLAID_ENV=sandbox                    # sandbox | production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_TOKEN_ENC_KEY=                 # 32-byte key; Plaid access tokens are encrypted at rest
FINANCE_PIN=                         # PIN that unlocks balances on the Finance tab

# --- School ---------------------------------------------------------------------
CANVAS_BASE_URL=                     # e.g. https://<school>.instructure.com
CANVAS_ACCESS_TOKEN=

# --- Calendar -------------------------------------------------------------------
GOOGLE_CALENDAR_ICAL_URL=            # secret iCal address of a Google Calendar (read-only mirror)

# --- Telegram capture bot -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=                    # only this Telegram user may talk to the bot
TELEGRAM_WEBHOOK_SECRET=

# --- Machine-to-machine ---------------------------------------------------------
CRON_SECRET=                         # Bearer token Vercel Cron sends to /api/cron/*
FITNESS_INGEST_SECRET=               # external lifting app → POST /api/fitness/workouts
JOBS_INGEST_SECRET=                  # Gmail Apps Script → job-alert feed
AKROV_INGEST_SECRET=                 # Gmail Apps Script → venture inbox feed
